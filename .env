# Copy this file to backend/.env and fill in real values.
# Never commit the real .env — it's in .gitignore.

# --- Supabase (Postgres) --------------------------------------------------
# Create a free project at https://supabase.com, run backend/schema.sql in
# its SQL editor, then paste the project URL and a service-role (or anon,
# if you've opened RLS for the hackathon) key below.
# If left blank, Bima Farm runs against a local JSON file store instead
# (backend/data/local_store.json) — the whole app still works, it just
# isn't shared across machines.
SUPABASE_URL=
SUPABASE_KEY=
# --- Hackathon model API ---------------------------------------------------
# OpenAI-compatible endpoint provided for the event. If left blank, the
# agent runs entirely in DEMO AI MODE (rule-based threshold checks,
# no model calls) — the app still works end to end.
HACKATHON_KEY=
HACKATHON_BASE_URL=
# --- Azure Text-to-Speech (Nepali voice confirmation) ----------------------
# If left blank, claim approval still works: an SMS-length text confirmation
# is generated, just no audio file (text-only fallback, clearly labelled).
AZURE_TTS_KEY=
AZURE_TTS_REGION=centralindia
AZURE_TTS_VOICE=ne-NP-HemkalaNeural

# --- Scheduler --------------------------------------------------------------
# How often the background agent checks readings against policies, in
# seconds. Default is 25200s (7 hours) — a realistic DHM-style gauge refresh
# cadence rather than a demo-fast tick. The first run still fires almost
# immediately (AGENT_FIRST_RUN_DELAY_SECONDS below), so a scheduler-triggered
# run lands quickly for the trace; use "Check Now" for on-demand pacing
# during a live demo. Lower this (e.g. 180) if you want the scheduler itself
# to tick faster during development.
AGENT_INTERVAL_SECONDS=25200
AGENT_FIRST_RUN_DELAY_SECONDS=15